{
  "name": "nodefit-vscode",
  "displayName": "nodefit",
  "description": "Finds the Node.js version every dependency supports, and flags native modules with no prebuilt binary before node-gyp fails.",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "publisher": "AbdullahMasood-005",
  "author": "Abdullah Masood",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pypilot-dev/nodefit",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/pypilot-dev/nodefit/issues"
  },
  "homepage": "https://github.com/pypilot-dev/nodefit/tree/main/packages/vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "node",
    "nvm",
    "engines",
    "node-gyp",
    "native modules",
    "prebuild",
    "compatibility"
  ],
  "activationEvents": [
    "workspaceContains:package.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nodefit.showReport",
        "title": "Show Report",
        "category": "nodefit",
        "icon": "$(preview)"
      },
      {
        "command": "nodefit.checkPackage",
        "title": "Check a Package\u2026",
        "category": "nodefit",
        "icon": "$(checklist)"
      },
      {
        "command": "nodefit.pinNode",
        "title": "Pin Node Version\u2026",
        "category": "nodefit",
        "icon": "$(pinned)"
      },
      {
        "command": "nodefit.refresh",
        "title": "Re-check the Project",
        "category": "nodefit",
        "icon": "$(refresh)"
      },
      {
        "command": "nodefit.showOutput",
        "title": "Show Output",
        "category": "nodefit",
        "icon": "$(output)"
      }
    ],
    "configuration": {
      "title": "nodefit",
      "properties": {
        "nodefit.notifications": {
          "type": "string",
          "enum": [
            "problems-only",
            "all",
            "off"
          ],
          "enumDescriptions": [
            "Notify about errors and warnings, once per session each.",
            "Also say once when every dependency fits.",
            "No notifications; the status bar and package.json diagnostics still show problems."
          ],
          "default": "problems-only",
          "description": "When nodefit shows notifications after checking the project.",
          "scope": "resource"
        },
        "nodefit.includeDevDependencies": {
          "type": "boolean",
          "default": true,
          "description": "Include devDependencies (and what only they pull in) when working out which Node releases fit. Turn off when development tools run on a different Node than the app.",
          "scope": "resource"
        },
        "nodefit.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the nodefit language server to the nodefit output.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "bun run build.ts",
    "watch": "bun run build.ts --watch",
    "package": "bun run build --production && bunx @vscode/vsce package --no-dependencies",
    "e2e": "bun run build && bun e2e/run.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "nodefit": "workspace:*",
    "typescript": "5.9.3",
    "vscode-languageclient": "9.0.1"
  }
}
