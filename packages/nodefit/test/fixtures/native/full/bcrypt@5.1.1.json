{
  "name": "bcrypt",
  "version": "5.1.1",
  "engines": {
    "node": ">= 10.0.0"
  },
  "dependencies": {
    "node-addon-api": "^5.0.0",
    "@mapbox/node-pre-gyp": "^1.0.11"
  },
  "scripts": {
    "install": "node-pre-gyp install --fallback-to-build"
  },
  "binary": {
