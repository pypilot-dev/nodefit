    "package_name": "{module_name}-v{version}-napi-v{napi_build_version}-{platform}-{arch}-{libc}.tar.gz",
    "napi_versions": [3]
  },
  "repository": {
    "url": "git+https://github.com/kelektiv/node.bcrypt.js.git",
    "type": "git"
  },
  "dist": {
    "tarball": "https://registry.npmjs.org/bcrypt/-/bcrypt-5.1.1.tgz",
    "unpackedSize": 110858
  }
}
